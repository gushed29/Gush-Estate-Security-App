# =====================================================================
# GUSH SECURITY EXTERNAL PHP CONNECTOR — ENVIRONMENT CONFIGURATION
# =====================================================================

# Environment mode: 'production', 'staging', or 'development'
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

# Production Gush Hub / Gateway Endpoint URL
# Official Production Gateway: https://api.sstore.ng/api/gsecurity/api-access
# Local LAN Hub Fallback: https://lan.gushsecurity.local:8443/api/v1
GUSH_HUB_URL=https://api.sstore.ng/api/gsecurity/api-access
GUSH_API_VERSION=v1

# Security Credentials (Generated in Gush Hub Admin -> Integrations)
GUSH_ESTATE_ID=pinnock_estate_01
GUSH_API_KEY=gush_live_a8f93b74c2d1e0f982341bc5
GUSH_API_SECRET=sec_7f9b8c2d1a3e5f4a6b8c0d2e4f6a8b0c

# Replay Protection & Drift Allowance (in seconds)
GUSH_ALLOWED_DRIFT_SECONDS=300

# Server-Side Database Connection (MySQL / MariaDB / PostgreSQL / SQLite)
# Note: Keep database on private server/LAN. Never expose to client apps!
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gush_security_db
DB_USERNAME=gush_db_user
DB_PASSWORD=ChangeThisToAStrongSecretPassword!
DB_CHARSET=utf8mb4

# For SQLite (optional alternative):
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/storage/gush_security.sqlite

# Logging and Storage Paths
LOG_FILE=storage/logs/gush_connector.log
LOG_LEVEL=INFO
